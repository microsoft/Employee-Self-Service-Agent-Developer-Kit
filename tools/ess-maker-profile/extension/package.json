{
  "name": "ess-maker-profile",
  "displayName": "ESS Maker",
  "description": "Chat-only, big-button experience for customizing your Employee Self-Service agent. POC.",
  "version": "0.4.26",
  "publisher": "microsoft-ess",
  "private": true,
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "essMaker.runSetup",
        "title": "ESS Maker: Connect to environment",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.runCreate",
        "title": "ESS Maker: Create a topic",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.runFlightcheck",
        "title": "ESS Maker: Validate readiness (FlightCheck)",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.runScan",
        "title": "ESS Maker: Scan for issues",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.runPush",
        "title": "ESS Maker: Push to Copilot Studio",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.applyMakerLayout",
        "title": "ESS Maker: Apply Maker Layout",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.restoreStandardLayout",
        "title": "ESS Maker: Restore Standard Layout",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.openWalkthrough",
        "title": "ESS Maker: View Tutorial",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.focusActions",
        "title": "ESS Maker: Show Action Buttons",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.startChatOnly",
        "title": "ESS Maker: Start Chat-Only Layout",
        "category": "ESS Maker"
      },
      {
        "command": "essMaker.runUpdate",
        "title": "Agent Developer Kit: Modify a topic",
        "category": "Agent Developer Kit"
      },
      {
        "command": "essMaker.openIntroduction",
        "title": "Agent Developer Kit: Introduction",
        "category": "Agent Developer Kit"
      },
      {
        "command": "essMaker.showItemInfo",
        "title": "Agent Developer Kit: About this step",
        "category": "Agent Developer Kit",
        "icon": "$(info)"
      },
      {
        "command": "essMaker.openDocs",
        "title": "Agent Developer Kit: Open documentation",
        "category": "Agent Developer Kit"
      },
      {
        "command": "essMaker.openGuidedLayout",
        "title": "Agent Developer Kit: Open guided setup view",
        "category": "Agent Developer Kit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "essMakerActions",
          "title": "Agent Developer Kit",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "essMakerActions": [
        {
          "type": "webview",
          "id": "essMaker.actionsView",
          "name": "Quick start",
          "contextualTitle": "Agent Developer Kit"
        },
        {
          "id": "essMaker.customizationView",
          "name": "Customization",
          "contextualTitle": "Agent Developer Kit"
        },
        {
          "id": "essMaker.helpView",
          "name": "Help",
          "contextualTitle": "Agent Developer Kit"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "essMaker.showItemInfo",
          "when": "view == essMaker.customizationView && viewItem =~ /adkInfo/",
          "group": "inline"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "essMaker.gettingStarted",
        "title": "Welcome to the Agent Developer Kit!",
        "description": "Build, update, and publish your Employee Self-Service agent with plain English. No code required.",
        "steps": [
          {
            "id": "introduction",
            "title": "Introduction",
            "description": "**Actions (left):** quick actions, customization, and help — everything you need to drive the build from one rail.\n**Preview (center):** follow the steps in the same workspace as your agent.\n**Copilot chat (right):** describe what you want your ESS agent to do; Copilot turns your intent into set-up steps, topics, and configuration.\n[Open Copilot Chat](command:workbench.action.chat.open)",
            "media": { "markdown": "walkthrough/introduction.md" },
            "completionEvents": ["onCommand:workbench.action.chat.open"]
          },
          {
            "id": "setup",
            "title": "Set up your environment",
            "description": "Sign in to your Power Platform environment.\n[Start set up](command:essMaker.runSetup)",
            "media": { "markdown": "walkthrough/connect.md" },
            "completionEvents": ["onCommand:essMaker.runSetup"]
          },
          {
            "id": "create",
            "title": "Create a topic",
            "description": "Describe a new conversation in plain English.\n[Create a topic](command:essMaker.runCreate)",
            "media": { "markdown": "walkthrough/create-topic.md" },
            "completionEvents": ["onCommand:essMaker.runCreate"]
          },
          {
            "id": "modify",
            "title": "Modify a topic",
            "description": "Change how an existing topic behaves.\n[Modify a topic](command:essMaker.runUpdate)",
            "media": { "markdown": "walkthrough/modify-topic.md" },
            "completionEvents": ["onCommand:essMaker.runUpdate"]
          },
          {
            "id": "flightcheck",
            "title": "Run a flightcheck",
            "description": "Run 41+ readiness checks before you deploy.\n[Run a flightcheck](command:essMaker.runFlightcheck)",
            "media": { "markdown": "walkthrough/flightcheck.md" },
            "completionEvents": ["onCommand:essMaker.runFlightcheck"]
          },
          {
            "id": "push",
            "title": "Push to Copilot",
            "description": "Safely deploy your changes to Copilot Studio.\n[Push to Copilot Studio](command:essMaker.runPush)",
            "media": { "markdown": "walkthrough/push.md" },
            "completionEvents": ["onCommand:essMaker.runPush"]
          }
        ]
      }
    ],
    "configuration": {
      "title": "ESS Maker",
      "properties": {
        "essMaker.mode": {
          "type": "string",
          "enum": ["lite", "standard", ""],
          "default": "",
          "description": "Install mode set by the ESS installer. 'lite' applies chat-first layout; 'standard' uses default VS Code layout with /setup injection only."
        },
        "essMaker.autoUpdateCheck": {
          "type": "boolean",
          "default": true,
          "description": "On VS Code startup, check whether the local ESS ADK clone is behind origin/main and, if so, offer a one-click update. Set to false (e.g. via IT/Intune policy) to disable the nudge on managed machines."
        }
      }
    }
  },
  "scripts": {
    "test": "node extension.test.js",
    "validate": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8'))\""
  }
}
