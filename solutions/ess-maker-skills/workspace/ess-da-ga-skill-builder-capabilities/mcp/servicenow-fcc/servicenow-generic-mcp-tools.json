{
    "tools": [
        {
            "name": "sn__list_records",
            "description": "List records from any ServiceNow table (Table API). table: table name, e.g. sn_hr_core_case, sc_req_item, incident. query: encoded query, e.g. 'active=true^opened_for=javascript:gs.getUserID()^ORDERBYDESCsys_created_on'. fields: comma-separated fields to return (default all). limit (default 20, max 100) and offset page through results. display_value: 'false' (raw values, the default), 'true' (labels, e.g. state 'Closed Complete' and people's names) or 'all' (both).",
            "inputSchema": {
                "properties": {
                    "table": {
                        "type": "string"
                    },
                    "query": {
                        "default": "",
                        "type": "string"
                    },
                    "fields": {
                        "default": "",
                        "type": "string"
                    },
                    "limit": {
                        "default": 20,
                        "type": "integer"
                    },
                    "offset": {
                        "default": 0,
                        "type": "integer"
                    },
                    "display_value": {
                        "default": "false",
                        "type": "string"
                    },
                    "exclude_reference_link": {
                        "default": true,
                        "type": "boolean"
                    }
                },
                "required": [
                    "table"
                ],
                "type": "object"
            },
            "title": "List records",
            "_meta": {
                "ess": {
                    "audience": "user",
                    "access": "read",
                    "layer": "runtime"
                }
            },
            "annotations": {
                "readOnlyHint": true
            }
        },
        {
