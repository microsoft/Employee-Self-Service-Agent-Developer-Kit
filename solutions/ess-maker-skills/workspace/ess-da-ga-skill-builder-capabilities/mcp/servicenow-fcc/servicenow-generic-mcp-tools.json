        {
            "name": "sn__create_record",
            "description": "Create a record in a ServiceNow table. body: JSON object of field names and values. input_display_value=true treats body values as labels (e.g. state 'In Progress') instead of raw values. Returns the created record (with sys_id and number). display_value: 'false' (raw values, the default), 'true' (labels, e.g. state 'Closed Complete' and people's names) or 'all' (both).",
            "inputSchema": {
                "properties": {
                    "table": {
                        "type": "string"
                    },
                    "body": {
                        "additionalProperties": true,
                        "type": "object"
                    },
                    "input_display_value": {
                        "default": false,
                        "type": "boolean"
                    },
                    "fields": {
                        "default": "",
                        "type": "string"
                    },
                    "display_value": {
                        "default": "false",
                        "type": "string"
                    }
                },
                "required": [
                    "table",
                    "body"
                ],
                "type": "object"
            },
            "title": "Create record",
            "_meta": {
                "ess": {
                    "audience": "user",
                    "access": "write",
                    "layer": "runtime"
                }
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false
            }
        },
