{
  "contractRevision": 16,
  "provider": "servicenow-da-hrsd",
  "displayName": "ServiceNow HRSD",
  "profile": "hrsd",
  "checkpointResultMode": "compact-stdout-v1",
  "attestedRoleScope": "lifecycle",
  "planRoles": [
    "ESS Maker / Agent Developer",
    "ServiceNow Admin / security_admin",
    "Microsoft Entra Application Administrator or higher",
    "Power Platform Maker / Admin"
  ],
  "stateMigrationCommand": "python scripts/connect_servicenow_da.py --provider servicenow-da-hrsd --agent-slug {agentSlug} migrate-state",
  "stateInitializationCommand": "python scripts/connect_servicenow_da.py --provider servicenow-da-hrsd --agent-slug {agentSlug} initialize-state --contract-revision {contractRevision}",
  "detect": {
    "checkpoint": "SN-DA-HRSD-PKG-001",
    "meansInstalled": "Passed",
    "meansNotInstalled": "NotConfigured"
  },
  "businessGroups": [
    {
      "id": "hr-prerequisite",
      "label": "HR prerequisite",
      "role": "ServiceNow admin",
      "phaseIds": ["plugin-prerequisites"]
    },
    {
      "id": "entra-identity",
      "label": "Entra identity",
      "role": "Entra admin",
      "phaseIds": ["entra-registration"]
    },
    {
      "id": "servicenow-sso",
      "label": "ServiceNow SSO and user mapping",
      "role": "ServiceNow admin / security_admin",
      "phaseIds": ["servicenow-oidc"]
    },
    {
      "id": "maker-configuration",
      "label": "Maker configuration and validation",
      "role": "Maker",
      "phaseIds": [
        "credential",
        "agent-connection",
        "topics",
        "portal-url",
        "test"
      ]
    }
  ],
  "phases": [
    {
      "id": "preflight",
      "label": "Discover existing ServiceNow admin setup and identify missing or unhealthy items",
      "responsibleRoles": ["ESS Maker / Agent Developer"],
      "checkpoints": ["SN-DA-HRSD-ADMIN-PREFLIGHT-001"],
      "completionStatuses": ["Passed"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/admin-preflight.md",
      "actionExecution": "every-invocation",
      "mutates": false
    },
    {
      "id": "plugin-prerequisites",
      "label": "Confirm HR Service Delivery Core is installed and ready",
      "responsibleRoles": ["ServiceNow Admin"],
      "checkpoints": ["SN-DA-HRSD-PLUGIN-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/verify-plugin-prerequisites.md",
      "actionExecution": "once",
      "manualAcknowledgementEvidence": {
        "path": "adminSetup.phaseHandoffs.{phaseId}",
        "evidenceObjectPath": "evidence",
        "acceptedRecordStatuses": ["completed", "reused"],
        "requiredEvidenceKind": "structured-admin-attestation"
      },
      "mutates": false
    },
    {
      "id": "entra-registration",
      "label": "Guide and verify the Microsoft Entra User Login application setup",
      "responsibleRoles": ["Microsoft Entra Application Administrator or higher"],
      "checkpoints": ["SN-DA-HRSD-ENTRA-SETUP-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/guide-entra-registration.md",
      "actionExecution": "once",
      "manualAcknowledgementEvidence": {
        "path": "adminSetup.phaseHandoffs.{phaseId}",
        "evidenceObjectPath": "evidence",
        "acceptedRecordStatuses": ["completed", "reused"],
        "requiredEvidenceKind": "structured-admin-attestation"
      },
      "mutates": false
    },
    {
      "id": "servicenow-oidc",
      "label": "Guide the ServiceNow OIDC provider and claim-to-field mapping setup",
      "responsibleRoles": ["ServiceNow Admin / security_admin"],
      "checkpoints": ["SN-DA-HRSD-OIDC-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/guide-servicenow-oidc.md",
      "actionExecution": "once",
      "manualAcknowledgementEvidence": {
        "path": "adminSetup.phaseHandoffs.{phaseId}",
        "evidenceObjectPath": "evidence",
        "acceptedRecordStatuses": ["completed", "reused"],
        "requiredEvidenceKind": "structured-admin-attestation",
        "requiredValues": {
          "identityMappingReceiptConfirmed": true,
          "mappingReceiptCurrent": true,
          "mappingDetailsCollected": true
        }
      },
      "mutates": false
    },
    {
      "id": "credential",
      "label": "Create or explicitly reuse the exact ServiceNow physical connection",
      "responsibleRoles": ["ESS Maker / Agent Developer"],
      "checkpoints": ["SN-DA-HRSD-CREDENTIAL-001"],
      "completionStatuses": ["Passed"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/prepare-credential.md",
      "actionExecution": "once",
      "resumeActionWhenIncomplete": true,
      "mutates": false
    },
    {
      "id": "agent-connection",
      "label": "Connect the selected ServiceNow credential to this agent",
      "responsibleRoles": ["ESS Maker / Agent Developer"],
      "checkpoints": ["SN-DA-HRSD-AGENT-CONNECTION-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/connect-agent.md",
      "actionExecution": "every-invocation",
      "manualAcknowledgementEvidence": {
        "path": "evidence.agentConnection",
        "evidenceObjectPath": "",
        "acceptedRecordStatuses": ["completed"],
        "requiredEvidenceKind": "maker-attestation",
        "requiredValues": {
          "makerAttested": true,
          "physicalStatus": "Connected",
          "authMode": "entraIDUserLogin"
        },
        "bindings": [
          {"evidencePath": "binding.provider", "statePath": "provider"},
          {"evidencePath": "binding.profile", "statePath": "profile"},
          {"evidencePath": "binding.agentSlug", "statePath": "agentSlug"},
          {"evidencePath": "binding.agentId", "statePath": "agentId"},
          {
            "evidencePath": "binding.environmentId",
            "statePath": "environmentId"
          },
          {
            "evidencePath": "binding.bindingIdentitySha256",
            "statePath": "agentBindingIdentitySha256"
          },
          {
            "evidencePath": "connectionId",
            "statePath": "evidence.credential.connectionId"
          }
        ]
      },
      "mutates": true,
      "requiredRole": "ESS Maker / Agent Developer",
      "gateMode": "attested"
    },
    {
      "id": "topics",
      "label": "Prepare the ServiceNow HRSD topics for this agent",
      "responsibleRoles": ["ESS Maker / Agent Developer"],
      "checkpoints": ["SN-DA-HRSD-TOPICS-001"],
      "completionStatuses": ["Passed", "Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/prepare-topics.md",
      "actionExecution": "once",
      "resumeActionWhenIncomplete": true,
      "manualAcknowledgementEvidence": {
        "path": "evidence.topics",
        "evidenceObjectPath": "",
        "acceptedRecordStatuses": ["recorded"],
        "requiredEvidenceKind": "maker-attestation",
        "requiredValues": {
          "customerChoice": "keep-current",
          "makerAttested": true
        },
        "bindings": [
          {
            "evidencePath": "boundComponentHash",
            "statePath": "componentHash"
          }
        ]
      },
      "mutates": true,
      "requiredRole": "ESS Maker / Agent Developer",
      "gateMode": "attested"
    },
    {
      "id": "portal-url",
      "label": "Configure the ServiceNow employee portal Base URI",
      "responsibleRoles": [
        "ESS Maker / Agent Developer",
        "ServiceNow Admin (provides portal URL)"
      ],
      "checkpoints": ["SN-DA-HRSD-PORTAL-001"],
      "completionStatuses": ["Passed"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/configure-portal-url.md",
      "actionExecution": "once",
      "resumeActionWhenIncomplete": true,
      "mutates": true,
      "requiredRole": "ESS Maker / Agent Developer",
      "gateMode": "attested"
    },
    {
      "id": "test",
      "label": "Confirm a ServiceNow HRSD request works in the Test pane",
      "responsibleRoles": ["ESS Maker / Agent Developer"],
      "checkpoints": ["SN-DA-HRSD-TEST-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/test-connection.md",
      "actionExecution": "every-invocation",
      "manualAcknowledgementEvidence": {
        "path": "evidence.test",
        "evidenceObjectPath": "",
        "acceptedRecordStatuses": ["completed"],
        "requiredEvidenceKind": "maker-attestation",
        "requiredValues": {
          "promptCategory": "list-my-open-hr-cases",
          "result": "pass",
          "failureCategory": null
        },
        "bindings": [
          {"evidencePath": "binding.provider", "statePath": "provider"},
          {"evidencePath": "binding.profile", "statePath": "profile"},
          {"evidencePath": "binding.agentSlug", "statePath": "agentSlug"},
          {"evidencePath": "binding.agentId", "statePath": "agentId"},
          {
            "evidencePath": "binding.environmentId",
            "statePath": "environmentId"
          },
          {
            "evidencePath": "binding.connectionId",
            "statePath": "evidence.credential.connectionId"
          },
          {
            "evidencePath": "binding.draftSemanticHash",
            "statePath": "draftSemanticHash"
          },
          {
            "evidencePath": "binding.connectionBindingHash",
            "statePath": "connectionBindingHash"
          }
        ]
      },
      "mutates": false
    }
  ]
}
