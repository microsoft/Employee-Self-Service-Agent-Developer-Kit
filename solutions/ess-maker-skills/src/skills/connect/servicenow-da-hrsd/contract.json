{
  "contractRevision": 3,
  "provider": "servicenow-da-hrsd",
  "displayName": "ServiceNow HRSD",
  "profile": "hrsd",
  "attestedRoleScope": "lifecycle",
  "stateMigrationCommand": "python scripts/connect_servicenow_da.py migrate-state",
  "detect": {
    "checkpoint": "SN-DA-HRSD-PKG-001",
    "meansInstalled": "Passed",
    "meansNotInstalled": "NotConfigured"
  },
  "phases": [
    {
      "id": "preflight",
      "label": "Discover existing ServiceNow admin setup and identify missing or unhealthy items",
      "checkpoints": ["SN-DA-HRSD-ADMIN-PREFLIGHT-001"],
      "completionStatuses": ["Passed"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/admin-preflight.md",
      "actionExecution": "every-invocation",
      "mutates": false
    },
    {
      "id": "plugin-prerequisites",
      "label": "Confirm HR Service Delivery Core is installed and Active",
      "checkpoints": ["SN-DA-HRSD-PLUGIN-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/verify-plugin-prerequisites.md",
      "actionExecution": "once",
      "manualAcknowledgementEvidence": {
        "path": "adminSetup.phaseHandoffs.{phaseId}",
        "acceptedRecordStatuses": ["completed", "reused"],
        "requiredEvidenceKind": "structured-admin-attestation"
      },
      "mutates": false
    },
    {
      "id": "entra-registration",
      "label": "Guide and verify the Microsoft Entra User Login application setup",
      "checkpoints": ["SN-DA-HRSD-ENTRA-*"],
      "completionStatuses": ["Passed", "Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/guide-entra-registration.md",
      "actionExecution": "once",
      "manualAcknowledgementEvidence": {
        "path": "adminSetup.phaseHandoffs.{phaseId}",
        "acceptedRecordStatuses": ["completed", "reused"],
        "requiredEvidenceKind": "structured-admin-attestation"
      },
      "mutates": false
    },
    {
      "id": "servicenow-oidc",
      "label": "Guide the ServiceNow OIDC provider and active-user mapping setup",
      "checkpoints": ["SN-DA-HRSD-OIDC-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/guide-servicenow-oidc.md",
      "actionExecution": "once",
      "manualAcknowledgementEvidence": {
        "path": "adminSetup.phaseHandoffs.{phaseId}",
        "acceptedRecordStatuses": ["completed", "reused"],
        "requiredEvidenceKind": "structured-admin-attestation"
      },
      "mutates": false
    },
    {
      "id": "credential",
      "label": "Create or explicitly reuse the exact ServiceNow physical connection",
      "checkpoints": ["SN-DA-HRSD-CREDENTIAL-001"],
      "completionStatuses": ["Passed"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/prepare-credential.md",
      "actionExecution": "once",
      "mutates": false
    },
    {
      "id": "topics",
      "label": "Prepare the ServiceNow HRSD topics for this agent",
      "checkpoints": ["SN-DA-HRSD-TOPICS-001"],
      "completionStatuses": ["Passed", "Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/prepare-topics.md",
      "actionExecution": "once",
      "mutates": true,
      "requiredRole": "ESS Maker / Agent Developer",
      "gateMode": "attested"
    },
    {
      "id": "agent-connection",
      "label": "Connect the selected ServiceNow credential to this agent",
      "checkpoints": ["SN-DA-HRSD-AGENT-CONNECTION-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/connect-agent.md",
      "actionExecution": "every-invocation",
      "mutates": true,
      "requiredRole": "ESS Maker / Agent Developer",
      "gateMode": "attested"
    },
    {
      "id": "parameter-sharing",
      "label": "Confirm the ServiceNow connection's parameter-sharing behavior",
      "checkpoints": ["SN-DA-HRSD-PARAMETER-SHARING-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/configure-parameter-sharing.md",
      "actionExecution": "every-invocation",
      "mutates": true,
      "requiredRole": "ESS Maker / Agent Developer",
      "gateMode": "attested"
    },
    {
      "id": "publish",
      "label": "Publish the current ServiceNow HRSD agent revision",
      "checkpoints": ["SN-DA-HRSD-PUBLISH-001"],
      "completionStatuses": ["Passed", "Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/publish-agent.md",
      "actionExecution": "once",
      "mutates": true,
      "requiredRole": "ESS Maker / Agent Developer",
      "gateMode": "attested"
    },
    {
      "id": "test",
      "label": "Confirm a ServiceNow HRSD request works in the Test pane",
      "checkpoints": ["SN-DA-HRSD-TEST-001"],
      "completionStatuses": ["Manual"],
      "actionDoc": "src/skills/connect/servicenow-da-hrsd/actions/test-connection.md",
      "actionExecution": "every-invocation",
      "mutates": false
    }
  ]
}
