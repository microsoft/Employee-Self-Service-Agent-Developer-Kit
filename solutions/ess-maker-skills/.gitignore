# Ignore everything in workspace/ and .local/ EXCEPT the .gitkeep scaffolds
workspace/**
!workspace/
!workspace/onboarding/
!workspace/agents/
!workspace/plan/
!workspace/**/.gitkeep

.local/**
!.local/
!.local/.gitkeep

# Kit-internal state can also land under scripts/.local/ when tools are run
# from the scripts dir (e.g. `python adk_telemetry.py --selftest`). Never commit.
scripts/.local/

# Generated local MCP configuration and Copilot worktrees
.vscode/mcp.json
copilot-worktrees/

# ISV reference docs synced from an internal ESS reference source (never committed)
src/reference/ess-docs/isv/

# Runtime-heuristics docs synced from an internal ESS reference source (never committed)
src/reference/ess-docs/runtime/

# Per-environment MCP server config written by /setup at runtime (holds the
# maker's Dataverse URL / connection details) — never commit; .vscode/settings.json
# and extensions.json are the only tracked .vscode files.
.vscode/mcp.json

